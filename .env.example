# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8080
TZ=America/New_York
PUBLIC_URL=https://reviews.brandname.com
STOREFRONT_ORIGIN=https://brandname.com
BRAND_NAME=Brandname

# --- Host port binding (read by docker-compose, not the app) ---
# Mercury's Tailscale IP — restricts the published port to the Tailscale
# interface so only the Oracle relay (and other tailnet peers) can reach it.
HOST_BIND_IP=100.117.6.18
# 8080 for the prod stack; 8081 for the dev stack.
HOST_PORT=8080

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=brandname.myshopify.com
# Client ID from the Reviews app's Settings page on dev.shopify.com.
# Used by the one-shot install-shopify script to start the OAuth flow.
SHOPIFY_CLIENT_ID=
# Admin API access token — filled in by running:
#   npm run install-shopify:dev -- --shop <store-handle>
# That script prints the token; paste it here.
SHOPIFY_ADMIN_TOKEN=
# The Reviews app's client secret from dev.shopify.com — same value used by
# both the install flow (as client_secret) and runtime webhook HMAC verification.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-01

# --- Email link signing (32+ random bytes; generate via: openssl rand -hex 32) ---
EMAIL_TOKEN_SECRET=

# --- Admin UI ---
# Password hash: node -e "import('bcrypt').then(b => b.default.hash('your-password', 12).then(console.log))"
ADMIN_PASSWORD_HASH=
# Session cookie signing: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_DAYS=14

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=brand-gmail-account@gmail.com
SMTP_PASS=
SMTP_FROM=Reviews <reviews@brandname.com>
