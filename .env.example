# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8080
TZ=America/New_York
PUBLIC_URL=https://reviews.brandname.com
STOREFRONT_ORIGIN=https://brandname.com
BRAND_NAME=Brandname

# --- Host port binding (read by docker-compose, not the app) ---
# Mercury's Tailscale IP — restricts the published port to the Tailscale
# interface so only the GCP relay (and other tailnet peers) can reach it.
HOST_BIND_IP=100.117.6.18
# Published host port: 8070 for the prod stack, 8071 for the dev stack.
# Maps to the container's fixed internal port 8080.
HOST_PORT=8070

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=brandname.myshopify.com
# Client ID (a.k.a. API key) from the Reviews app on dev.shopify.com. Public;
# used by the install-shopify flow and as the App Bridge API key in the admin.
SHOPIFY_CLIENT_ID=
# Admin API access token — filled in by running:
#   npm run install-shopify:dev -- --shop <store-handle>
# That script prints the token; paste it here. (Newer tokens use the shpua_ prefix.)
SHOPIFY_ADMIN_TOKEN=
# The Reviews app's client secret from dev.shopify.com. One value, three uses:
# OAuth callback signing, webhook HMAC verification, and embedded-admin session
# token (JWT) verification.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-01

# --- Email link signing (32+ random bytes; generate via: openssl rand -hex 32) ---
EMAIL_TOKEN_SECRET=

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=brand-gmail-account@gmail.com
SMTP_PASS=
SMTP_FROM=Reviews <reviews@brandname.com>
# Operator notifications (panic activations, etc.) — leave empty to skip.
DEV_NOTIFICATION_EMAIL=
