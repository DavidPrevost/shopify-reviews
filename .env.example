# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8080
TZ=America/New_York
PUBLIC_URL=https://reviews.brandname.com
STOREFRONT_ORIGIN=https://brandname.com
BRAND_NAME=Brandname

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=brandname.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-01

# --- Email link signing (32+ random bytes; generate via: openssl rand -hex 32) ---
EMAIL_TOKEN_SECRET=

# --- Admin UI ---
# Password hash: node -e "import('bcrypt').then(b => b.default.hash('your-password', 12).then(console.log))"
ADMIN_PASSWORD_HASH=
# Session cookie signing: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_DAYS=14

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=brand-gmail-account@gmail.com
SMTP_PASS=
SMTP_FROM=Reviews <reviews@brandname.com>

# --- Cloudflare Tunnel ---
CLOUDFLARED_TOKEN=
