# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8080
TZ=America/New_York
PUBLIC_URL=https://reviews.brandname.com
STOREFRONT_ORIGIN=https://brandname.com

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=brandname.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Email link signing (32+ random bytes, hex or base64) ---
EMAIL_TOKEN_SECRET=

# --- Admin UI ---
# Generate via: node -e "import('bcrypt').then(b => b.hash('your-password', 12).then(console.log))"
ADMIN_PASSWORD_HASH=

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=brand-gmail-account@gmail.com
SMTP_PASS=
SMTP_FROM=Reviews <reviews@brandname.com>

# --- Cloudflare Tunnel ---
CLOUDFLARED_TOKEN=
